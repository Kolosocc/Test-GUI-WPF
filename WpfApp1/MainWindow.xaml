<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="250" Width="400">
    <StackPanel Margin="20">
        <Label Content="Введите имя:"/>
        <TextBox x:Name="UserNameInput" 
                 AutomationProperties.AutomationId="LoginField" 
                 Width="200" Margin="10"/>

        <Button x:Name="SubmitButton" 
                Content="Войти" 
                AutomationProperties.AutomationId="LoginButton"
                Click="SubmitButton_Click" 
                Width="100"/>

        <TextBlock x:Name="StatusMessage" 
                   AutomationProperties.AutomationId="StatusText" 
                   FontSize="16" Foreground="Green" Margin="20" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>